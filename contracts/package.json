{
  "name": "wave-contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "fetch-solc": "bash scripts/fetch-solc.sh",
    "compile": "hardhat compile --no-tests",
    "test": "forge test",
