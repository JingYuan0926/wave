{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Agent",
      "NotebookEdit",
      "mcp__claude_ai_Claude_Docs__update",
      "mcp__claude_ai_Claude_Docs__read",
      "mcp__claude_ai_Claude_Docs__batch",
      "mcp__claude_ai_Claude_Docs__create",
      "Bash([ -f \"$f\" ])",
      "Bash(python3 -u -c ' *)",
      "mcp__wave"
    ],
    "defaultMode": "bypassPermissions"
  },
  "alwaysThinkingEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "enabledMcpjsonServers": [
    "wave"
  ],
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/mcp/watch-approval.mjs\"",
            "timeout": 185,
            "statusMessage": "Watching for your approval\u2026"
          }
        ]
      }
    ]
  }
}
