# Copy this file to .env.local. Every value is optional.
# With no World ID values, WAVE uses the local test identity. It is not a real World ID.

# World ID. Set all three to use real IDKit proofs. Get them at https://developer.world.org
NEXT_PUBLIC_WORLD_APP_ID=
NEXT_PUBLIC_RP_ID=
# The Portal shows this key once. Keep it on the server. Do not commit it.
RP_SIGNING_KEY=
# staging: the World simulator, https://simulator.worldcoin.org. No Orb and no phone.
# production: World App on a phone. The onchain 3.0 path needs Orb verification.
NEXT_PUBLIC_WORLD_ENV=staging
# Optional RPC for World Chain root reads. The default is the public RPC of the chain.
WORLD_CHAIN_RPC_URL=

# World ID Agent Pass: an OIDC login for human approval. It is separate from the IDKit values above.
# With no client ID or secret, Settings shows "Agent Pass is not configured" and the action stays blocked.
# The issuer is the sandbox by default. Production is https://auth.world.org.
AGENT_PASS_ISSUER=https://sandbox.auth.world.org
AGENT_PASS_CLIENT_ID=
# Keep this on the server. Do not commit it. WAVE sends it with HTTP Basic.
AGENT_PASS_CLIENT_SECRET=
# The World portal accepts HTTPS callbacks only, so use a tunnel to port 3000 in place of this default.
AGENT_PASS_REDIRECT_URI=http://localhost:3000/api/agent-pass/callback
# Accepted acr values, in a comma list. These are the only two in the sandbox discovery document.
AGENT_PASS_ACR=https://world.org/oidc/acr/orb,https://world.org/oidc/acr/orb-face

# The demo agent key: 32 bytes of hex. The server signs agent wallet spends with it, so the human
# checkpoint is a server rule, not a chain rule. Use a key that holds no real value.
# Create one with: openssl rand -hex 32, then add 0x in front.
WAVE_AGENT_DEMO_KEY=

# Delay cap for new accounts, in seconds. The address commits to it. 0 means real delays.
WAVE_DEMO_DELAY=120

# Local network only: the gas station pays for every wallet. The devnet has no sponsor.
# Sponsored transactions per wallet per day. The server enforces this before it signs.
# WAVE_SPONSOR_DAILY_TX=50

# The faucet and root publishing accept local callers only. Set 1 to reach them from a phone on the LAN.
# WAVE_ALLOW_LAN=1

# The network. Change this one line to swap, then restart the dev server.
# local:  your own stack from devnet/up.sh.
# devnet: the public alt-mempool devnet. Each network has its own deployments/<network>.json.
WAVE_NETWORK=local

# Needed for devnet only: a funded key that deploys, publishes roots and runs the faucet.
# Do not use a key that holds real value. The local network does not need this.
# WAVE_DEV_KEY=0x...

# Optional. These override the URLs that WAVE_NETWORK selects.
# WAVE_RPC_URL=
# WAVE_SIDECAR_URL=
# WAVE_EXPLORER_URL=
